<odoo>
  <data>
    <template id="website_redeem_stamp_products" name="Redeem Stamp Products">
      <t t-call="website.layout">
        <div class="container py-4">
          <h2 class="mb-4">Available Rewards for <t t-esc="card.program_id.name"/></h2>
          <a t-att-href="'/my/redeems/select_card'" 
             class="btn btn-danger btn-sm d-block mx-auto mt-2" 
             style="padding: 0.5rem 1.5rem; width: 50%;">Back</a>
          <hr/>

          <t t-if="products">
            <div class="row">
              <t t-foreach="products" t-as="p">
                <div class="col-md-6 mb-4 d-flex">
                  <div class="card h-100 shadow-sm w-100">
                    <!-- row flex for responsive layout -->
                    <div class="row g-0 flex-column flex-md-row">

                      <!-- image -->
                      <div class="col-md-5">
                        <div style="padding:0.8rem; width:100%; height:180px; overflow:hidden; display:flex; align-items:center; justify-content:center;">
                          <img t-att-src="p['image']" style="max-height:100%; max-width:100%; object-fit:contain;" alt="Product Image"/>
                        </div>
                      </div>

                      <!-- content -->
                      <div class="col-md-7 d-flex">
                        <div class="card-body d-flex flex-column justify-content-between">
                          <div>
                            <h5 class="card-title"><t t-esc="p['name']"/></h5>
                            <p class="card-text"><t t-esc="int(p['point'])"/> stamp</p>
                          </div>
                          <a t-att-href="'/my/redeems_stamp/new?card_id={}&amp;product_id={}'.format(p['card_id'], p['id'])"
                             class="btn btn-success btn-sm w-100 mt-2" style="padding: 0.5rem 1.5rem;">Redeem</a>
                        </div>
                      </div>

                    </div>
                  </div>
                </div>
              </t>
            </div>
          </t>

          <t t-else="">
            <div class="alert alert-warning text-center mt-4" role="alert">
              Sorry, there are no stamp rewards available at the moment.
            </div>
          </t>

        </div>
      </t>
    </template>
  </data>
</odoo>
